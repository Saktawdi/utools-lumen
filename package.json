{
  "name": "lumen-utools",
  "version": "0.2.4",
  "description": "轻量的 uTools BYOK Agent 聊天插件",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Saktawdi/utools-lumen.git"
  },
  "homepage": "https://github.com/Saktawdi/utools-lumen#readme",
  "bugs": "https://github.com/Saktawdi/utools-lumen/issues",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-catalog.mjs && vite --host 127.0.0.1",
    "build": "node scripts/sync-catalog.mjs && tsc -b && vite build && node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/sync-catalog.mjs --check && node --test tests/*.test.cjs",
    "test:native": "npm run build && node scripts/verify-native.mjs && node scripts/verify-native.mjs --no-workers",
    "check": "tsc -b && npm test",
    "format": "prettier --write src runtime scripts tests public/plugin.json *.json *.ts index.html",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "utools-api-types": "^8.0.0",
    "vite": "^6.3.5"
  }
}
